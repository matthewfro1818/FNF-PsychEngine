import funkin.play.PlayState;
import funkin.play.character.AnimateAtlasCharacter;
import flixel.FlxG;
import animate.internal.elements.FlxSpriteElement;
import funkin.graphics.FunkinSprite;
import funkin.play.stage.Bopper;
import funkin.util.assets.FlxAnimationUtil;

class KillerByteCharacter extends AnimateAtlasCharacter {
	function new() {
		super('kb');
	}

	var eyes:FunkinSprite;

	function onCreate(event:ScriptEvent) {
		super.onCreate(event);	

		if (debug) return;

		eyes = new Bopper();
		eyes.zIndex = 305;
		eyes.loadTextureAtlas("characters/kb_export/eyes", "shared");
		FlxAnimationUtil.addTextureAtlasAnimations(eyes, _data.animations);
		// no shaders
		for (anim in _data.animations)
      		(anim.offsets == null) ?  eyes.setAnimationOffsets(anim.name, 0, 0) : eyes.setAnimationOffsets(anim.name, anim.offsets[0], anim.offsets[1]);

    	PlayState.instance.currentStage.add(eyes);
    	PlayState.instance.currentStage.refresh(); 
	}
	public override function playAnimation(name:String, restart:Bool = false, ignoreOther:Bool = false, reversed:Bool = false):Void
	{
    	super.playAnimation(name, restart, ignoreOther, reversed);

		if (eyes != null)
		{
      		eyes.playAnimation(name, restart, ignoreOther);
      		eyes.setPosition(this.x + 254, this.y + 275 - 44);
		}
	}
}