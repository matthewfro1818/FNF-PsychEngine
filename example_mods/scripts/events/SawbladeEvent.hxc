import flixel.FlxG;
import funkin.Paths;
import funkin.Conductor;
import funkin.play.PlayState;
import funkin.play.event.SongEvent;
import funkin.play.scoring.Scoring;
import funkin.save.Save;

class SawbladeEvent extends SongEvent {

    public function new() {
        super('sawKB');
    }
    var interval:Float;
    var hitWindow:Float;
    var hitTime:Float;

    public override function handleEvent(data:SongEventData):Void {
        if (Save.instance.modOptions.get(QtOptionsCategory.SAVE_KEY_SAWBLADE_MODE_QT) == "disabled") return;

        Conductor.instance.update();
        var playState = PlayState.instance;
        playState.mayPauseGame = false;
        interval = Conductor.instance.beatLengthMs / 1000;
        hitWindow = playState.currentDifficulty == "hard" ? Scoring.PBOT1_GOOD_THRESHOLD : Scoring.PBOT1_GOOD_THRESHOLD;
        hitTime = data.time + interval * 2000;
        playState.currentStage.scriptGet('moduleCheck').scriptSet("activeEvent", this.superClass);
        playState.currentStage.scriptGet('moduleCheck').scriptSet("_interval", interval);
        playState.currentStage.scriptGet('moduleCheck').scriptCall("executeWarning");
    }

    public override function getTitle():String {
        return "Sawblade Event (QT)";
    }
    
    public override function getIconPath():String {
        return 'ui/chart-editor/events/sawKB';
    }
}