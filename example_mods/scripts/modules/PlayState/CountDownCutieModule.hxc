import funkin.play.PlayState;
import funkin.modding.module.Module;
import funkin.audio.FunkinSound;
import funkin.Paths;
import flixel.util.FlxTimer;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import funkin.Conductor;
import funkin.data.song.SongRegistry;
import funkin.ui.mainmenu.MainMenuState;
import flixel.FlxG;
import StringTools;
import funkin.Preferences;
import funkin.ui.FullScreenScaleMode;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.util.FlxTimerManager;
import funkin.util.TouchUtil;
import funkin.save.Save;

class CountDownCutieModule extends Module {
	private var hasPlayedQtCountDown:Bool = false;
	private var cutsceneConductor:Conductor;
	private var songIntro:FunkinSound;
	private var easterEgg:Bool;
	private var ps:PlayState;
	private var _bf:Dynamic;
	private var _dad:Dynamic;
	private var _gf:Dynamic;
	private var _stage:Dynamic;
	
	// Skip system variables
	private var skipText:FlxText;
	private var cutsceneSkipped:Bool = false;
	private var canSkipCutscene:Bool = false;
	private var cutsceneTimerManager:FlxTimerManager;
	private var isMobilePauseButtonPressed:Bool = false;
	
	// Sound references for cleanup
	private var cutsceneSfx:FunkinSound;
	private var picoSfx:FunkinSound;
	private var stoneMovingSound:FunkinSound;
	

	public function new() {
		super('CountDownCutieModule', 1, {state: PlayState});
	}

	public override function isSongPico(currentDifficulty:String, currentVariation:String):Bool {
		return currentVariation == 'pico' && !Save.instance.hasBeatenSong(this.id, null, 'pico');
	}

	private inline function picoHi():Void {
		_bf.playAnimation('introbl' + (easterEgg ? '-easter' : ''), false,false,false);
	}

	function onUpdate(event:UpdateScriptEvent):Void {
		super.onUpdate(event);
		
		if (cutsceneTimerManager != null) 
			cutsceneTimerManager.update(event.elapsed);
		
		if (PlayState.instance.isInCutscene && cutsceneConductor != null) {
			cutsceneConductor.update(songIntro.time);
		}
		
		if (FlxG.onMobile) {
			isMobilePauseButtonPressed = TouchUtil.overlapsComplex(PlayState.instance.pauseButton) && TouchUtil.justPressed;
		}
		
		if ((PlayState.instance.controls.CUTSCENE_ADVANCE || isMobilePauseButtonPressed) && !cutsceneSkipped) {
			if (!canSkipCutscene) {
				if (skipText != null) {
					FlxTween.tween(skipText, {alpha: 1}, 0.5, {ease: FlxEase.quadOut});
					new FlxTimer().start(0.5, _ -> {
						canSkipCutscene = true;
					});
				}
			}
		}
		
		if ((PlayState.instance.controls.CUTSCENE_ADVANCE || isMobilePauseButtonPressed) && !cutsceneSkipped && canSkipCutscene) {
			skipCutscene();
		}
	}

	function onDestroy(event):Void {
		super.onDestroy(event);
		cleanup();
	}

	public function onStateChangeBegin(event):Void {
		super.onStateChangeBegin(event);
		cleanup();
	}

	private inline function cleanup():Void {
		hasPlayedQtCountDown = false;
		cutsceneConductor = null;
		songIntro = null;
		_dad = null;
		_gf = null;
		_stage = null;
		ps = null;
		_bf = null;
		cutsceneSkipped = false;
		canSkipCutscene = false;
		cutsceneSfx = null;
		picoSfx = null;
		stoneMovingSound = null;
		skipText = null;
		cutsceneTimerManager = null;
	}

	public override function onCountdownStart(event:CountdownScriptEvent):Void {
		super.onCountdownStart(event);

		ps = PlayState.instance;

		if (hasPlayedQtCountDown || ps.isChartingMode) return;

		_stage = ps.currentStage;
		if (_stage == null) return;

		_bf = _stage.getBoyfriend();
		_dad = _stage.getDad();

		if (_dad?.characterId != 'qt') return;

		ps.isInCutscene = true;
		ps.camHUD.visible = false;
		ps.camHUD.alpha = 0;
		PlayState.instance.camCutscene.fade(0xFF000000, 0.1, false, null, true);

		event.cancel();
		qtCountDown();
	}

	private inline function onCutsceneBeatHit():Void {
		_gf.dance(true);
	}

	private inline function showHUD(duration:Float = 1):Void {
		ps.camHUD.visible = true;
		ps.camHUD.alpha = 0;
		FlxTween.tween(ps.camHUD, {alpha: 1}, duration, {ease: FlxEase.smoothStepInOut});
	}

	private inline function startGameplay():Void {
		ps.isInCutscene = false;
		ps.startCountdown();
	}

	private function qtCountDown():Void {
		var opX = _dad.cameraFocusPoint.x;
		var opY = _dad.cameraFocusPoint.y;
		var plX = _bf.cameraFocusPoint.x;
		var plY = _bf.cameraFocusPoint.y;
		var zoom = ps.stageZoom;

		var isPico = _bf?.characterId.toLowerCase().indexOf('pico') == 0;
		var variation = ps.currentVariation;
		var isPicoVar = variation == 'pico';

		ps.tweenCameraToPosition(opX, opY - 235, 0);
		
		cutsceneTimerManager = new FlxTimerManager();

		var musicPath = "gameplay/introSong/introSong" + (isPicoVar ? "-pico" : "-boyfriend");

		cutsceneSfx = FunkinSound.load(Paths.sound("gameplay/countdown/" + Save.instance.modOptions.get(QtOptionsCategory.SAVE_KEY_LANG_QT) + "/hi_cutie"), true);
		if (Preferences.subtitles) 
			PlayState.instance.subtitles.assignSubtitles('subtitles/' + Save.instance.modOptions.get(QtOptionsCategory.SAVE_KEY_LANG_QT) + '/hi-cutie', cutsceneSfx);
		picoSfx = isPico ? FunkinSound.load(Paths.sound("gameplay/cutsceneSfx/pico/introCutscene/picoWave"), true) : null;
		stoneMovingSound = FunkinSound.load(Paths.sound("gameplay/stoneMoving"), true);
		stoneMovingSound.volume = 0.6;

		songIntro = FunkinSound.load(Paths.music(musicPath, "shared"), true);
		songIntro.play();
		songIntro.volume = 0.1;

		skipText = new FlxText(936 * FullScreenScaleMode.wideScale.x, 618 * FullScreenScaleMode.wideScale.y, 0, 
			'Skip [ ' + PlayState.instance.controls.getDialogueNameFromToken("CUTSCENE_ADVANCE", true) + ' ]', 20);
		
		if (FlxG.onMobile) {
			skipText.text = 'Skip [Pause Button]';
			skipText.x -= 136;
		}
		
		skipText.setFormat(Paths.font('vcr.ttf'), 40, 0xFFFFFFFF, "right", FlxTextBorderStyle.OUTLINE, 0xFF000000);
		skipText.scrollFactor.set();
		skipText.borderSize = 2;
		skipText.alpha = 0;
		PlayState.instance.currentStage.add(skipText);
		skipText.cameras = [PlayState.instance.camCutscene];

		hasPlayedQtCountDown = true;

		ps.tweenCameraToPosition(opX, opY, 2.75, FlxEase.expoOut);
		ps.tweenCameraZoom(zoom * 1.1875, 2.75, true, FlxEase.expoOut);

		cutsceneConductor = new Conductor();
		_gf = _stage.getGirlfriend();

		var songMusicData = SongRegistry.instance.parseMusicData(musicPath);
		if (songMusicData != null) 
			cutsceneConductor.mapTimeChanges(songMusicData.timeChanges);

		cutsceneConductor.onBeatHit.add(onCutsceneBeatHit);

		PlayState.instance.camCutscene.fade(0xFF000000, 2.75, true, null, true);

		_dad.playAnimation("still", true, true);
		new FlxTimer(cutsceneTimerManager).start(0.5, (_) -> _dad.playAnimation("intro",true, true));
		new FlxTimer(cutsceneTimerManager).start(0.98, (_) -> cutsceneSfx.play());

		easterEgg = Math.random() < 0.01;


		if (!isPico) {
			new FlxTimer(cutsceneTimerManager).start(4, (_) -> {
				disableSkip();
				showHUD();
				ps.tweenCameraZoom(zoom, 4, true, FlxEase.smoothStepInOut);
			});

			new FlxTimer(cutsceneTimerManager).start(4.5, (_) -> startGameplay());
		} 
		else if (easterEgg) {
			canSkipCutscene = false;
			skipText.visible = false;
			
			songIntro.volume = 0;
			ps.tweenCameraToPosition(opX - 250, opY, 0);
			ps.tweenCameraZoom(zoom * 1.5, 0, true, FlxEase.quadInOut);

			picoHi();

			new FlxTimer(cutsceneTimerManager).start(3.5, (_) -> {
				stoneMovingSound.play();
				ps.tweenCameraToPosition(plX + 100, plY, 5, FlxEase.smoothStepInOut);
				ps.tweenCameraZoom(zoom, 5, true, FlxEase.smoothStepInOut);
			});

			new FlxTimer(cutsceneTimerManager).start(4, (_) -> _dad.playAnimation("disgust", true, true));

			new FlxTimer(cutsceneTimerManager).start(7, (_) -> {
				FlxG.openURL("https://youtu.be/SpEf-YtSwwc");
				FlxG.switchState(new MainMenuState());
			});
		} 
		else {
			// Pico variation: can skip ONLY until picoHi
			new FlxTimer(cutsceneTimerManager).start(3.5, (_) -> {
				// DISABLE SKIP after picoHi starts
				disableSkip();
				
				ps.tweenCameraToPosition(plX + 100, plY, 3, FlxEase.quadInOut);
				picoHi();
			});

			new FlxTimer(cutsceneTimerManager).start(4.15, (_) -> picoSfx.play());

			new FlxTimer(cutsceneTimerManager).start(6.35, (_) -> 
				ps.tweenCameraZoom(zoom * 1.25, 1.5, true, FlxEase.quadInOut)
			);

			new FlxTimer(cutsceneTimerManager).start(11, (_) -> {
				showHUD();
				startGameplay();
			});
		}
	}
	
	private function disableSkip():Void {
		cutsceneSkipped = true; // Mark as skipped to prevent skip logic
		canSkipCutscene = false;
		
		if (skipText != null) {
			FlxTween.tween(skipText, {alpha: 0}, 0.5, {
				ease: FlxEase.quadIn,
				onComplete: _ -> {
					skipText.visible = false;
				}
			});
		}
	}

	private function skipCutscene():Void {
		cutsceneSkipped = true;
		hasPlayedQtCountDown = true;

		PlayState.instance.camCutscene.fade(0xFF000000, 0.5, false, null, true);

		if (cutsceneSfx != null) cutsceneSfx.fadeOut(0.5, 0);
		if (songIntro != null) songIntro.fadeOut(0.5, 0);
		if (picoSfx != null) picoSfx.fadeOut(0.5, 0);
		if (stoneMovingSound != null) stoneMovingSound.fadeOut(0.5, 0);

		new FlxTimer().start(0.5, _ -> {
			PlayState.instance.justUnpaused = true;
			PlayState.instance.camCutscene.fade(0xFF000000, 0.5, true, null, true);

			if (cutsceneTimerManager != null) 
				cutsceneTimerManager.clear();

			if (songIntro != null) songIntro.stop();
			if (cutsceneSfx != null) cutsceneSfx.stop();
			if (picoSfx != null) picoSfx.stop();
			if (stoneMovingSound != null) stoneMovingSound.stop();

			if (skipText != null) skipText.visible = false;
			_dad.dance(true);
			_bf.dance(true);
			ps.tweenCameraToPosition(_dad.cameraFocusPoint.x, _dad.cameraFocusPoint.y, 0, FlxEase.expoOut);
			ps.tweenCameraZoom(ps.stageZoom, 0, true, FlxEase.expoOut);
			showHUD();
			startGameplay();
		});
	}
}