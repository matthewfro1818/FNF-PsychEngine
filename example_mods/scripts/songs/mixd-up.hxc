import funkin.play.song.Song;
import funkin.save.Save;
import funkin.play.PlayState;
import funkin.graphics.FunkinSprite;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import flixel.util.FlxTimerManager;
import funkin.graphics.shaders.DropShadowShader;
import funkin.audio.FunkinSound;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import funkin.play.PlayStatePlaylist;
import funkin.util.TouchUtil;
import Date;

class MixdUpSong extends Song {
	function new() {
		super('mixd-up');
	}

	var hasPlayedCutscene:Bool = false;

	var isMobilePauseButtonPressed:Bool = false;

	function onCreate(event:ScriptEvent):Void {
		super.onCreate(event);

		hasPlayedCutscene = false;

		if (PlayState.instance.isChartingMode && !hasPlayedCutscene)
			hasPlayedCutscene = true;

		if (!FlxG.onMobile) {
			PlayState.instance.discordRPCAlbum = "https://raw.githubusercontent.com/LeGooeyy/GooeyMixDiscordIcons/refs/heads/main/assets/album-covers/"
				+ PlayState.instance.currentChart.album
				+ ".png?raw=true";
			PlayState.instance.discordRPCIcon = "https://raw.githubusercontent.com/LeGooeyy/GooeyMixDiscordIcons/refs/heads/main/assets/icons/"
				+ PlayState.instance.currentChart.characters.opponent
				+ ".png?raw=true?t="
				+ Date.now().getTime();
		}
	}

	public override function onCountdownStart(event:CountdownScriptEvent):Void {
		super.onCountdownStart(event);

		if (!hasPlayedCutscene) {
			trace('Pausing countdown to play a cutscene (`gooey`)');

			hasPlayedCutscene = true;

			event.cancel(); // CANCEL THE COUNTDOWN!

			preloadMixCut();
			mixCut();
		}
	}

	function onUpdate(event:UpdateScriptEvent):Void {
		super.onUpdate(event);

		if (cutsceneTimerManager != null)
			cutsceneTimerManager.update(event.elapsed);

		if (FlxG.onMobile) {
			isMobilePauseButtonPressed = TouchUtil.overlapsComplex(PlayState.instance.pauseButton) && TouchUtil.justPressed;
		}
	}

	var cutsceneTimerManager:FlxTimerManager;

	function preloadMixCut() {
		// PlayState.instance.camGame.alpha = 0;
		PlayState.instance.camHUD.alpha = 0;
		PlayState.instance.currentStage.getDad().visible = true;

		PlayState.instance.currentStage.refresh();
		FlxG.camera.fade(0xFF000000, 1, true);
		var mixPos:Array<Float> = [
			PlayState.instance.currentStage.getDad().cameraFocusPoint.x,
			PlayState.instance.currentStage.getDad().cameraFocusPoint.y
		];
		PlayState.instance.tweenCameraZoom(1, 0.01, true, FlxEase.expoOut);
		PlayState.instance.tweenCameraToPosition(mixPos[0] + 1000, mixPos[1] + 30, 0.01, FlxEase.expoOut);
	}

	function mixCut() {
		var mixPos:Array<Float> = [
			PlayState.instance.currentStage.getDad().cameraFocusPoint.x,
			PlayState.instance.currentStage.getDad().cameraFocusPoint.y
		];

		cutsceneTimerManager = new FlxTimerManager();
		PlayState.instance.isInCutscene = true;

		new FlxTimer(cutsceneTimerManager).start(0.365, _ -> {
			cutsceneMusic = FunkinSound.load(Paths.music("cutscene/mixed-up-melody"), true);
			cutsceneMusic.volume = 1;
			cutsceneMusic.play(false);
		});

		new FlxTimer(cutsceneTimerManager).start(1, _ -> {
			PlayState.instance.tweenCameraToPosition(mixPos[0] - 10, mixPos[1] + 30, 3, FlxEase.quadInOut);
			PlayState.instance.tweenCameraZoom(0.8, 3, true, FlxEase.quadOut);
		});

		new FlxTimer(cutsceneTimerManager).start(3, _ -> {
			PlayState.instance.currentStage.getDad().playAnimation('showOffassBITCH', true);
			mixCutAudio = FunkinSound.load(Paths.sound('extra/mixCutAudio'), 1, false, true, true);
			PlayState.instance.tweenCameraZoom(0.9, 3, true, FlxEase.expoOut);
		});

		new FlxTimer(cutsceneTimerManager).start(3.5, _ -> {
			PlayState.instance.tweenCameraZoom(0.85, 3, true, FlxEase.expoOut);
		});
		new FlxTimer(cutsceneTimerManager).start(4.05, _ -> {
			PlayState.instance.tweenCameraZoom(0.9, 1, true, FlxEase.elasticOut);
		});

		new FlxTimer(cutsceneTimerManager).start(5.1, _ -> {
			PlayState.instance.tweenCameraZoom(0.65, 6, true, FlxEase.expoOut);
			PlayState.instance.tweenCameraToPosition(mixPos[0], mixPos[1], 2, FlxEase.expoOut);

			hasPlayedCutscene = true;
			PlayState.instance.isInCutscene = false;

			cutsceneMusic.fadeOut(1, 0);

			PlayState.instance.startCountdown();

			FlxTween.tween(PlayState.instance.camHUD, {alpha: 1}, 1);
		});
	}
}
