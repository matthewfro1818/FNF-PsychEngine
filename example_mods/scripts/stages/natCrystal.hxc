import funkin.play.stage.Stage;
import funkin.graphics.shaders.DropShadowShader;
import funkin.play.character.CharacterType;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import flixel.util.FlxTimerManager;
import funkin.play.PlayState;
import flixel.util.FlxSave;

class natCrystalStage extends Stage {
	function new() {
		super('natCrystal');

		save = new FlxSave();
		save.bind("GooeyMixOptions", "FunkinCrew");
	}

	public function onGameOver(event:ScriptEvent) {
		super.onGameOver(event);
		if (save.data.gooeyShaders != false) {
			getBoyfriend().shader = null;
		}
	}

	var crystalTween1:FlxTween;
	var crystalTween2:FlxTween;
	var crystalTween3:FlxTween;
	var crystalTween4:FlxTween;
	var crystalTween5:FlxTween;

	function buildStage() {
		super.buildStage();

		var floorLight = getNamedProp('floorLight');
		floorLight.blend = 11;

		var bottomCrystalLight = getNamedProp('bottomCrystalLight');
		bottomCrystalLight.blend = 0;

		var natCrystalLight = getNamedProp('natCrystalLight');
		natCrystalLight.blend = 0;

		var natCrystalLight2 = getNamedProp('natCrystalLight2');
		natCrystalLight2.blend = 0;
		natCrystalLight2.alpha = 0;

		var overlay1 = getNamedProp('overlay1');
		overlay1.blend = 9;

		var overlay2 = getNamedProp('overlay2');
		overlay2.blend = 9;

		var overlay3 = getNamedProp('overlay3');
		overlay3.blend = 9;
		overlay3.alpha = 0.3;

		var backWallLights = getNamedProp('backWallLights');
		backWallLights.blend = 0;
		backWallLights.alpha = 0.0001;

		var bottomCrystalLight2 = getNamedProp('bottomCrystalLight2');
		bottomCrystalLight2.blend = 0;
		bottomCrystalLight2.alpha = 0.0001;

		var crystalReflections1 = getNamedProp('crystalReflections1');
		crystalReflections1.blend = 16; // 11 15 16

		var crystalReflections2 = getNamedProp('crystalReflections2');
		crystalReflections2.blend = 11; // 11 15 16

		var starcraftLight = getNamedProp('starcraftLight');
		starcraftLight.blend = 15; // 11 15 16

		var crystalBackWall = getNamedProp('crystalBackWall');
		crystalBackWall.blend = 0; // 11 15 16

		crystalReflections1.alpha = 0.0001; // 0.5
		crystalReflections2.alpha = 0.0001; // 0.5
		starcraftLight.alpha = 0.0001; // 0.7
		crystalBackWall.alpha = 0.0001; // 0.5

		addTweens();
	}

	function addTweens() {
		crystalTween1 = FlxTween.tween(getNamedProp('natCrystalLight'), {y: getNamedProp('natCrystalLight').y + 50}, 5, {ease: FlxEase.quadInOut, type: 4});
		crystalTween2 = FlxTween.tween(getNamedProp('natCrystalLight2'), {y: getNamedProp('natCrystalLight2').y + 50}, 5, {ease: FlxEase.quadInOut, type: 4});
		crystalTween3 = FlxTween.tween(getNamedProp('natCrystal'), {y: getNamedProp('natCrystal').y + 50}, 5, {ease: FlxEase.quadInOut, type: 4});

		crystalTween4 = FlxTween.tween(getNamedProp('crystalReflections1'), {angle: 360}, 30, {type: 2});
		crystalTween5 = FlxTween.tween(getNamedProp('crystalReflections2'), {angle: -360}, 40, {type: 2});
	}

	override function addCharacter(character:BaseCharacter, charType:CharacterType):Void {
		// Apply the shader automatically to each character as it gets added.
		super.addCharacter(character, charType);

		        if (charType == CharacterType.GF && character.characterId == 'gf') {
            character.originalPosition.x = character.x += 60;
			character.originalPosition.y = character.y -= 20;
            character.resetCameraFocusPoint();      
        }

		trace('Applied stage shader to ' + character.characterName);
		if (save.data.gooeyShaders != false) {
			var rim = new DropShadowShader();
			rim.setAdjustColor(-80, -24, -5, -10);
			// brightness  hue  contrast  saturation
			rim.color = 0xFFEF72F9;
			character.shader = rim;
			rim.attachedSprite = character;
			// rim.threshold = -1;

			switch (charType) {
				case CharacterType.BF:
					rim.angle = 112.5;

					character.animation.onFrameChange.add(function() {
						if (getBoyfriend() != null) {
							rim.updateFrameInfo(getBoyfriend().frame);
						}
					});

				case CharacterType.GF:
					rim.angle = 90;
					// rim.color = 0xFF000000;

					character.animation.onFrameChange.add(function() {
						rim.updateFrameInfo(getGirlfriend().frame);
					});

				case CharacterType.DAD:
					rim.angle = 112.5;
					character.animation.onFrameChange.add(function() {
						rim.updateFrameInfo(getDad().frame);
					});

				default:
			}
		}
	}

	function onPause(ev) {
		super.onPause(ev);

		// False...
		for (twn in [crystalTween1, crystalTween2, crystalTween3, crystalTween4, crystalTween5])
			twn.active = false;
	}

	function onResume(ev) {
		super.onResume(ev);

		// True...
		for (twn in [crystalTween1, crystalTween2, crystalTween3, crystalTween4, crystalTween5])
			twn.active = true;
	}

	function onSongRetry(event:ScriptEvent) {
		super.onSongRetry(event);
		if (PlayState.instance.currentSong.id.toLowerCase() == "starcraft") {
			getNamedProp('bottomCrystalLight2').alpha = 0;
			getNamedProp('natCrystalLight2').alpha = 0;
			getNamedProp('overlay3').alpha = 0;
			getNamedProp('backWallLights').alpha = 0;
			getNamedProp('crystalReflections1').alpha = 0;
			getNamedProp('crystalReflections2').alpha = 0;
			getNamedProp('starcraftLight').alpha = 0;
			getNamedProp('crystalBackWall').alpha = 0;
		}
	}

	function onStepHit(event:SongTimeScriptEvent):Void {
		super.onStepHit(event);
		if (PlayState.instance.currentSong.id.toLowerCase() == "starcraft") {
			if (event.step == 885) {
				FlxTween.tween(getNamedProp('bottomCrystalLight2'), {alpha: 1}, 2.8, {ease: FlxEase.quartin});
				FlxTween.tween(getNamedProp('natCrystalLight2'), {alpha: 1}, 2.8, {ease: FlxEase.quartin});
				FlxTween.tween(getNamedProp('overlay3'), {alpha: 1}, 2.8, {ease: FlxEase.quartin});
				FlxTween.tween(getNamedProp('backWallLights'), {alpha: 1}, 2.8, {ease: FlxEase.quartin});

				FlxTween.tween(getNamedProp('crystalReflections1'), {alpha: 0.4}, 2.8, {ease: FlxEase.quartin});
				FlxTween.tween(getNamedProp('crystalReflections2'), {alpha: 0.7}, 2.8, {ease: FlxEase.quartin});
				FlxTween.tween(getNamedProp('starcraftLight'), {alpha: 0.75}, 2.8, {ease: FlxEase.quartin});
				FlxTween.tween(getNamedProp('crystalBackWall'), {alpha: 0.5}, 2.8, {ease: FlxEase.quartin});
			}
			if (event.step == 1182) {
				FlxTween.tween(getNamedProp('bottomCrystalLight2'), {alpha: 0}, 1.2, {ease: FlxEase.quartin});
				FlxTween.tween(getNamedProp('natCrystalLight2'), {alpha: 0}, 1.2, {ease: FlxEase.quartin});
				FlxTween.tween(getNamedProp('overlay3'), {alpha: 0.3}, 1.2, {ease: FlxEase.quartin});
				FlxTween.tween(getNamedProp('backWallLights'), {alpha: 0}, 1.2, {ease: FlxEase.quartin});

				FlxTween.tween(getNamedProp('crystalReflections1'), {alpha: 0}, 1.2, {ease: FlxEase.quartin});
				FlxTween.tween(getNamedProp('crystalReflections2'), {alpha: 0}, 1.2, {ease: FlxEase.quartin});
				FlxTween.tween(getNamedProp('starcraftLight'), {alpha: 0}, 1.2, {ease: FlxEase.quartin});
				FlxTween.tween(getNamedProp('crystalBackWall'), {alpha: 0}, 1.2, {ease: FlxEase.quartin});
			}
		}
	}
}
